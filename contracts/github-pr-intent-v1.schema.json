{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline GitHub pull request intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "operation_id", "repository", "base", "head", "expected_base_sha", "expected_head_sha", "title", "body"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "operation_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "repository": {"type": "string", "maxLength": 140, "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "base": {"type": "string", "minLength": 1, "maxLength": 128},
    "head": {"type": "string", "minLength": 1, "maxLength": 128},
    "expected_base_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "expected_head_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "body": {"type": "string", "maxLength": 16384}
  }
}
