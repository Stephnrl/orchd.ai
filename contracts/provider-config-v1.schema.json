{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orchd:provider-config:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "model", "executable", "executable_sha256", "arguments", "delivery", "timeout_seconds", "max_output_bytes", "max_prompt_bytes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "provider": {"enum": ["github_copilot_cli", "abc_binary_ai_placeholder", "fixture_cli"]},
    "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 200},
    "executable": {"type": "string", "minLength": 1, "maxLength": 4096},
    "executable_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "arguments": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 4096}},
    "delivery": {"enum": ["stdin", "prompt_argument"]},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 120},
    "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
    "max_prompt_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
  }
}
