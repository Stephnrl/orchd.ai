{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:orchd:broker:1.0.0",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Envelope"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "started",
        "ended",
        "code",
        "stdout",
        "stderr",
        "truncated",
        "failure"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 32768
          }
        },
        "started": {
          "type": "string",
          "format": "date-time"
        },
        "ended": {
          "type": "string",
          "format": "date-time"
        },
        "code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "stdout": {
          "type": "string",
          "maxLength": 262144
        },
        "stderr": {
          "type": "string",
          "maxLength": 262144
        },
        "truncated": {
          "type": "boolean"
        },
        "failure": {
          "enum": [
            null,
            "timeout",
            "output_limit",
            "unreaped_stream",
            "executor_unavailable",
            "cleanup_uncertain"
          ]
        }
      }
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "task_id",
        "generation",
        "nonce",
        "workspace",
        "recipe",
        "args",
        "mode",
        "image",
        "source_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "source_digest": {
          "$ref": "#/$defs/Hash"
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "recipe": {
          "enum": [
            "edit",
            "test"
          ]
        },
        "args": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "enum": [
              "hello world\n",
              "wrong\n"
            ]
          }
        },
        "mode": {
          "enum": [
            "docker",
            "trusted-fixture"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        }
      }
    },
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation_id",
        "task_id",
        "generation",
        "nonce",
        "source_digest",
        "request_sha256",
        "result"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "task_id": {
          "$ref": "#/$defs/Id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "source_digest": {
          "$ref": "#/$defs/Hash"
        },
        "request_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "result": {
          "$ref": "#/$defs/Result"
        }
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "account_sha256",
        "uid",
        "gid"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "account_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "uid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "image"
      ],
      "properties": {
        "mode": {
          "enum": [
            "docker",
            "trusted-fixture"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "dispatch": {
          "type": "boolean"
        }
      }
    },
    "IdentityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "identity"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "IdentityReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "identity",
        "source_digest",
        "profile",
        "secret"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "identity"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "source_digest": {
          "$ref": "#/$defs/Hash"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "secret": {
          "$ref": "#/$defs/SecretState"
        }
      }
    },
    "ExecuteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "request"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "enum": [
            "execute",
            "result"
          ]
        },
        "request": {
          "$ref": "#/$defs/Request"
        }
      }
    },
    "ExecuteReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "envelope",
        "identity"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "enum": [
            "execute",
            "result"
          ]
        },
        "envelope": {
          "$ref": "#/$defs/Envelope"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        }
      }
    },
    "RetireRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "operation_id",
        "generation"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "retire"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "RetireReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "operation_id",
        "generation",
        "container_absent"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "retire"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "container_absent": {
          "type": "boolean"
        }
      }
    },
    "ReconcileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "operation_id"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "reconcile"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "ReconcileReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "operation_id",
        "container_absent"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "reconcile"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "container_absent": {
          "type": "boolean"
        }
      }
    },
    "ExecutionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "transport",
        "broker",
        "orchestrator",
        "separate_identity",
        "recorded_at"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "transport": {
          "enum": [
            "subprocess",
            "service"
          ]
        },
        "broker": {
          "$ref": "#/$defs/Identity"
        },
        "orchestrator": {
          "$ref": "#/$defs/Identity"
        },
        "separate_identity": {
          "type": "boolean"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "PilotExecutor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "image",
        "image_id",
        "host",
        "docker",
        "recipe_sha256",
        "broker"
      ],
      "properties": {
        "mode": {
          "const": "docker"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "host": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "system",
            "release",
            "machine",
            "hostname_sha256",
            "python"
          ],
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "release": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "machine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "hostname_sha256": {
              "$ref": "#/$defs/Hash"
            },
            "python": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "os_type",
            "server_version",
            "architecture"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "os_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "server_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "architecture": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "recipe_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "broker": {
          "$ref": "#/$defs/Identity"
        }
      }
    },
    "PilotScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_commit",
        "replacements",
        "checks",
        "before",
        "policy",
        "source_sha256",
        "journal_root",
        "id",
        "created_at",
        "executor",
        "expires_at"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "base_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "replacements": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "keys",
              "equals"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "keys": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "maxLength": 100
                }
              },
              "equals": {}
            }
          }
        },
        "before": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string",
            "maxLength": 65536
          }
        },
        "policy": {
          "const": "git-json-data-v1"
        },
        "source_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "journal_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "created_at": {
          "type": "string",
          "maxLength": 64
        },
        "expires_at": {
          "type": "string",
          "maxLength": 64
        },
        "executor": {
          "$ref": "#/$defs/PilotExecutor"
        },
        "task_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "store",
            "task_id"
          ],
          "properties": {
            "store": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "task_id": {
              "$ref": "#/$defs/Id"
            }
          }
        }
      }
    },
    "PilotObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "phase",
        "started_at",
        "ended_at",
        "argv_sha256",
        "input_sha256",
        "code",
        "failure",
        "truncated",
        "container_absent",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "labels"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 128
            },
            "labels": {
              "type": "object",
              "maxProperties": 3,
              "additionalProperties": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "phase": {
          "enum": [
            "edit",
            "test"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "argv_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "input_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "failure": {
          "enum": [
            null,
            "timeout",
            "output_limit",
            "unreaped_stream",
            "executor_unavailable",
            "cancelled"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "container_absent": {
          "type": "boolean"
        },
        "stdout_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/Hash"
        }
      }
    },
    "PilotProfileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "image"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "pilot-profile"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "PilotProfileReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "profile",
        "identity"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "pilot-profile"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "profile": {
          "$ref": "#/$defs/PilotExecutor"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        }
      }
    },
    "PilotExecuteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "scope",
        "phase",
        "workspace"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "pilot-execute"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "scope": {
          "$ref": "#/$defs/PilotScope"
        },
        "phase": {
          "enum": [
            "edit",
            "test"
          ]
        },
        "workspace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "PilotExecuteReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "observation",
        "output",
        "identity"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "pilot-execute"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "observation": {
          "$ref": "#/$defs/PilotObservation"
        },
        "output": {
          "type": [
            "object",
            "null"
          ]
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        }
      }
    },
    "PilotReconcileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "scope",
        "phase"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "pilot-reconcile"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "scope": {
          "$ref": "#/$defs/PilotScope"
        },
        "phase": {
          "enum": [
            "edit",
            "test"
          ]
        }
      }
    },
    "PilotReconcileReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "container_absent",
        "identity"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "pilot-reconcile"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "container_absent": {
          "type": "boolean"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        }
      }
    },
    "SecretState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "rotating",
        "age_seconds",
        "stale"
      ],
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "rotating": {
          "type": "boolean"
        },
        "age_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "boolean"
        }
      }
    },
    "DispatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "operation_id",
        "expected_sha256",
        "request"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "dispatch"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "operation_id": {
          "$ref": "#/$defs/Id"
        },
        "expected_sha256": {
          "$ref": "#/$defs/Hash"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "url",
            "headers"
          ],
          "properties": {
            "method": {
              "type": "string",
              "enum": [
                "POST",
                "PATCH",
                "PUT"
              ]
            },
            "url": {
              "type": "string",
              "maxLength": 2048
            },
            "headers": {
              "type": "object",
              "maxProperties": 16,
              "additionalProperties": {
                "type": "string",
                "maxLength": 1024
              },
              "propertyNames": {
                "pattern": "^[A-Za-z0-9-]{1,64}$"
              }
            },
            "body": {
              "type": "object"
            }
          }
        }
      }
    },
    "DispatchReply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "nonce",
        "identity",
        "receipt"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "kind": {
          "const": "dispatch"
        },
        "nonce": {
          "$ref": "#/$defs/Id"
        },
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "receipt": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "schema_version",
            "kind",
            "operation_id",
            "request_sha256",
            "origin",
            "method",
            "url",
            "outcome",
            "started_at",
            "ended_at",
            "simulated"
          ],
          "properties": {
            "kind": {
              "const": "DispatchReceipt"
            },
            "outcome": {
              "type": "string",
              "enum": [
                "succeeded",
                "failed",
                "uncertain"
              ]
            },
            "simulated": {
              "const": false
            }
          }
        }
      }
    }
  }
}
